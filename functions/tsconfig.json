{
  "compilerOptions": {
    "module": "nodenext",
    "target": "es2019",
    "esModuleInterop": true,
    "moduleResolution": "nodenext",
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "outDir": "lib",
    "rootDir": "src",
    "sourceMap": true,
    "strict": true
  },
  "ignoreDeprecations": "6.0",
  "compileOnSave": true,
  "include": ["src"]
}